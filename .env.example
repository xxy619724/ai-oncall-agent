# 配置模板：复制为 .env 后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥。

# 应用配置
APP_NAME=SuperBizAgent
DEBUG=False
# 仅监听本机；确需对外暴露时再改为 0.0.0.0，并同时配置鉴权与 CORS_ALLOW_ORIGINS
HOST=127.0.0.1
PORT=9900

# CORS 允许的来源（逗号分隔）。留空表示不放行任何跨域来源。
CORS_ALLOW_ORIGINS=http://localhost:9900

# 文档索引白名单：/api/index_directory 只允许索引这些目录（逗号分隔，相对项目根）
INDEX_ALLOWED_DIRS=uploads,aiops-docs

# DashScope 配置（必填）
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# 聊天多模态配置（Qwen-VL 视觉模型）
CHAT_MODEL=qwen-vl-max
# 单图 base64 长度上限（约 3MB 原图）
CHAT_IMAGE_MAX_BASE64_SIZE=4194304
# 图片外置存储：base64 落盘、消息里只留引用，避免 checkpoint 被图片撑大。
# False 退回旧行为（base64 直接进 checkpoint，一张图会随快照复制多份）。
CHAT_IMAGE_EXTERNAL_STORE=True
# 有多少「含图消息」保留真图送给模型，其余降级为文字占位。
# 1 = 只有当前轮的图片进视觉模型，避免历史图片每轮重复计费；0 = 永不还原。
CHAT_IMAGE_KEEP_RECENT_ROUNDS=1

# RAG 配置
RAG_TOP_K=10
RAG_MODEL=qwen-max

# 重排（Rerank）配置
RAG_RERANK_TOP_K=3
RAG_RERANK_MODEL=qwen3-rerank

# 上下文压缩配置
RAG_CONTEXT_WINDOW_SIZE=131072
RAG_COMPRESSION_THRESHOLD=0.7
RAG_KEEP_RECENT_ROUNDS=5
RAG_COMPRESSION_MODEL=qwen-max

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# transport 类型：stdio、sse（腾讯云等 /sse/ 端点）、streamable-http（本地 FastMCP）
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# Prometheus（告警查询工具等）
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0

# 对话记忆持久化
SQLITE_DB_PATH=./data/chat.db
REDIS_URL=redis://localhost:6379/0
REDIS_SUMMARY_TTL=604800
